reader = open("pg345.txt", encoding = "utf-8")

import re # The module re, is used for providing functions related to  regular expressions

text = "I am Dracula; and I bid you welcome, Mr. Harker, to my house."

pattern = 'Dracula'
def searching():
    result = re.search(pattern, text)  # object.method (Syntax for using any method) - Search Method:  It scans an entire string to find the first location where a given regular expression pattern produces a match;
    print(result.string) # It returns all the string
    print(result.group()) # It returns the part of the text that matched the pattern;
    print(result.span()) # It returns the index in the text where the pattern starts and ends;
    return result # If the pattern doesn't match the pattern, it returns "None";

def find_first(pattern):
    for line in reader:
        result = re.search(pattern, line)
        if result != None:
            return result

